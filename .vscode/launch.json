{
  // ==========================================================================
  //  VS Code 调试配置（ST-Link / SWD）
  //
  //  用法：打开 rm_arm 工程 → 左侧「运行和调试」面板（Ctrl+Shift+D）
  //        → 顶部下拉选 "STM32 调试 (ST-Link)" → 按 F5
  //
  //  依赖：扩展 stmicroelectronics.stm32cube-ide-debug-stlink-gdbserver
  //        （提供 type = "stlinkgdbtarget"，已装 v1.5.1）
  //
  //  ⚠️ 三个必须知道的点：
  //   1) 调试会**独占 SWD**。调试期间不能再跑 STM32_Programmer_CLI 烧录，
  //      会报 "Error: failed to connect"。要先停止调试（Shift+F5）。
  //   2) 按 F5 **不会自动重新编译**。改了代码要先 build（Ctrl+Shift+B 或
  //      CMake Tools 的 Build 按钮），否则你调试的是旧固件 —— 断点位置全部错位，
  //      而且这种错位极难发现。
  //   3) 板子上电顺序不变：先共地、再舵机上电、最后主控上电。
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 调试 (ST-Link)",
      "type": "stlinkgdbtarget",
      "request": "launch",

      // 工作目录：${workspaceFolder} 就是 rm_arm 根目录
      "cwd": "${workspaceFolder}",

      // 要下载并调试的 ELF。写成字面路径，不依赖 CMake Tools 的"启动目标"设置，
      // 免得换了 preset 就找不到文件。
      //
      // ⚠️ 2026-11-17 修正：这里原来写的是 "executable"，那是 **cortex-debug**
      //    扩展的属性，ST 的 stlinkgdbtarget **不认**。不认也不会报错，只会静默忽略，
      //    后果是 GDB 里一个符号都没有 —— 断点是空心的、F5 停不下来、变量面板
      //    永远显示"不可用"、程序计数器显示成 "0x080081a8 in ?? ()"。
      //    这个扩展要的是 imagesAndSymbols 数组：
      //        imageFileName  = 要下载到 flash 的镜像
      //        symbolFileName = 用来读符号表的文件
      //    两者都指向同一个 .elf 就对了。
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/build/Debug/rm_arm.elf",
          "symbolFileName": "${workspaceFolder}/build/Debug/rm_arm.elf"
        }
      ],

      // 下载完先停到 main()，而不是一上来就跑飞。
      // 属性名是 runEntry（默认值就是 "main"，写出来是为了看得见）；
      // "runToEntryPoint" 同样是 cortex-debug 的写法，这个扩展不认。
      "runEntry": "main"
    }
  ]
}
